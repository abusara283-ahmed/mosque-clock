<?xml version="1.0" encoding="utf-8"?>
<!-- خادم المسجد على الشبكة المحلية يعمل بـ http (مثل http://192.168.1.10:8080/) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
